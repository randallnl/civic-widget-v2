{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nhcc-vote-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/widgets/vote-tracker/lookup", "/widgets/vote-tracker/demo"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
